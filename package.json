{
  "name": "transform-simulator",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "dist": "vite build && electron-builder --win"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@react-three/fiber": "^8.13.0",
    "@react-three/drei": "^9.80.0",
    "three": "^0.154.0",
    "@fontsource/source-serif-4": "^5.0.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.0.3",
    "electron": "^25.0.0",
    "electron-builder": "^24.6.0",
    "vite": "^4.4.5"
  },
  "build": {
    "appId": "com.transform.simulator",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "package.json"
    ],
    "win": {
      "target": "portable"
    }
  }
}